# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5050
# Public URL of this API (used for Telegram webhook + image URLs in dev)
API_URL=http://localhost:5050
# Frontend origin(s), comma separated. Used for CORS and links sent by the bot.
CLIENT_URL=http://localhost:5173

# ── Database (Supabase) ───────────────────────────────────
# Supabase → Project Settings → Database → Connection string
# Pooled (port 6543) for the app:
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct (port 5432) for migrations:
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Auth ──────────────────────────────────────────────────
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Initial owner account (used once by `npm run owner:create`)
OWNER_NAME="Hikma"
OWNER_PHONE=0955706969
OWNER_PASSWORD=

# ── Image storage (Supabase Storage) ──────────────────────
# Leave empty in development to store images on local disk (./uploads).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=products

# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=hikmafashionbot
# Random string; the webhook path becomes /api/telegram/webhook/<secret>
TELEGRAM_WEBHOOK_SECRET=
# Mini App short name set in BotFather (/newapp). Used for t.me/<bot>/<app>?startapp= links
# Local development only: receive updates by polling. Never enable while the
# production webhook is active for the same bot (it would remove the webhook).
TELEGRAM_POLLING=false

# ── Payments (optional) ───────────────────────────────────
# ShegerPay receipt verification. Empty = payments are verified manually by admins.
SHEGERPAY_API_KEY=
SHEGERPAY_BASE_URL=https://api.shegerpay.com/api/v1

# Development only: enables a "Developer sign-in" button on localhost, because the
# Telegram Login Widget refuses localhost. Ignored when NODE_ENV=production.
DEV_LOGIN=false

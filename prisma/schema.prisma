// Hikma Men's Fashion — data model
// Money is stored in whole Ethiopian birr (Int).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── People ──────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  OWNER
}

model User {
  id               String    @id @default(cuid())
  role             Role      @default(CUSTOMER)
  fullName         String
  phone            String?   @unique
  // Customers sign in with Telegram
  telegramId       BigInt?   @unique
  telegramUsername String?
  photoUrl         String?
  languageCode     String    @default("en")
  // Staff (OWNER / ADMIN) sign in with phone + password
  passwordHash     String?
  isActive         Boolean   @default(true)
  // Address remembered for the next checkout
  city             String?
  area             String?
  landmark         String?
  /// Opted in to new-arrival announcements on Telegram
  newsOptIn        Boolean   @default(false)
  newsOptInAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  orders          Order[]
  orderEvents     OrderEvent[]
  stockMoves      StockMovement[]
  stockAlerts     StockAlert[]
  cart            CartSnapshot?
  reviews         Review[]
  credits         CreditEntry[]
  wishlist        WishlistItem[]
  exchanges       ExchangeRequest[]
  supportRequests SupportRequest[]
  /// Personal invite code (created the first time they open "Invite a friend")
  referralCode    String?           @unique
  /// Who invited this customer (set by their first order with an invite code)
  referredById    String?
  /// Size memory + size helper answers: { height?, weight?, fit?, sizes: { <categorySlug>: <size> } }
  sizeProfile     Json?
}

/// "Notify me when back": one row per customer per sold-out size/colour.
model StockAlert {
  id         String    @id @default(cuid())
  userId     String
  variantId  String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([variantId, notifiedAt])
}

/// New-arrival announcement sent by the bot to opted-in customers. Sent in batches by a worker
/// (resumable via `cursor`), so a restart mid-send continues where it stopped.
model Broadcast {
  id          String    @id @default(cuid())
  productId   String
  createdById String?
  /// sending | done | cancelled
  status      String    @default("sending")
  cursor      String?
  total       Int       @default(0)
  sentCount   Int       @default(0)
  failedCount Int       @default(0)
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status])
}

/// Telegram order cards sent to the order-alerts chat. Tracked so that any change to the order —
/// from the dashboard, the bot or automation — updates every card (status text + valid buttons only).
model AdminCard {
  id        String   @id @default(cuid())
  orderId   String
  chatId    String
  messageId Int
  hasPhoto  Boolean  @default(false)
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─── Catalog ─────────────────────────────────────────────

enum ProductKind {
  APPAREL
  FOOTWEAR
  FRAGRANCE
  ACCESSORY
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id        String      @id @default(cuid())
  slug      String      @unique
  nameEn    String
  nameAm    String
  kind      ProductKind
  imageUrl  String?
  // Size options offered in the admin editor, e.g. ["S","M","L","XL","XXL"]
  sizes     String[]
  // Size guide rows: [{ "size": "M", "chest": "96-101", ... }]
  sizeGuide Json?
  sortOrder Int         @default(0)
  products  Product[]
}

model Brand {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  products Product[]
}

model Product {
  id              String        @id @default(cuid())
  slug            String        @unique
  nameEn          String
  nameAm          String?
  descriptionEn   String?
  descriptionAm   String?
  categoryId      String
  brandId         String?
  origin          String?
  material        String?
  fit             String?
  basePrice       Int
  compareAtPrice  Int?
  costPrice       Int?
  status          ProductStatus @default(DRAFT)
  isFeatured      Boolean       @default(false)
  isNewArrival    Boolean       @default(true)
  badge           String?
  tags            String[]
  // Fragrance only
  concentration   String?
  volumeMl        Int?
  scentFamily     String?
  notesTop        String[]
  notesHeart      String[]
  notesBase       String[]
  // Social
  tikTokUrl       String?
  telegramPostUrl String?
  // Source post id when imported from the Telegram channel export
  importRef       String?       @unique
  /// Average of published reviews (kept in sync when reviews change) — cheap to show on cards
  ratingAvg       Float?
  ratingCount     Int           @default(0)
  /// Pre-order: can be ordered without stock; customer pays the deposit now
  preorder        Boolean       @default(false)
  /// e.g. "Arrives from Turkey on 10 Dec"
  preorderNote    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category    Category         @relation(fields: [categoryId], references: [id])
  brand       Brand?           @relation(fields: [brandId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  broadcasts  Broadcast[]
  /// "Original" proof photos (box, tags, receipt). Any proof photo = Original badge.
  proofs      ProofPhoto[]
  reviews     Review[]
  bundleItems BundleItem[]
  wishlisted  WishlistItem[]

  @@index([status, categoryId])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  // Base path in storage; sizes are stored as <key>-sm.webp / -md.webp / -lg.webp
  key       String
  width     Int?
  height    Int?
  alt       String?
  color     String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

/// Photos proving the product is original (box, tags, purchase receipt). Kept apart from the
/// product photos so they never appear in the gallery, on cards or in channel posts.
model ProofPhoto {
  id        String   @id @default(cuid())
  productId String
  key       String
  width     Int?
  height    Int?
  /// box | tag | receipt | other
  label     String   @default("other")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

/// Customer review — only from someone who received the product (delivered / picked up order).
model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  orderId   String
  rating    Int
  text      String?
  /// size they bought, shown as "Bought: 50"
  size      String   @default("")
  /// published | hidden (hidden by staff)
  status    String   @default("published")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos  ReviewPhoto[]

  @@unique([userId, productId])
  @@index([productId, status, createdAt])
}

model ReviewPhoto {
  id        String @id @default(cuid())
  reviewId  String
  key       String
  width     Int?
  height    Int?
  sortOrder Int    @default(0)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  sku       String  @unique
  size      String  @default("")
  color     String  @default("")
  colorHex  String?
  price     Int?
  stock     Int     @default(0)
  isActive  Boolean @default(true)

  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  stockMoves StockMovement[]
  alerts     StockAlert[]

  @@unique([productId, size, color])
}

// ─── Orders ──────────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKING
  OUT_FOR_DELIVERY
  DELIVERED
  PICKED_UP
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  SUBMITTED
  PARTIAL
  PAID
  REJECTED
}

enum OrderSource {
  WEB
  MINI_APP
  ADMIN
  /// Walk-in sale at the shop counter (already paid and handed over)
  COUNTER
}

model Order {
  id                String            @id @default(cuid())
  orderNumber       String            @unique
  userId            String?
  source            OrderSource       @default(WEB)
  customerName      String
  customerPhone     String
  telegramChatId    BigInt?
  deliveryOptionId  String
  deliveryLabel     String
  city              String?
  area              String?
  landmark          String?
  lat               Float?
  lng               Float?
  subtotal          Int
  deliveryFee       Int?
  total             Int
  costTotal         Int               @default(0)
  // Amount the customer must pay now (full total, or the deposit)
  amountDue         Int
  amountPaid        Int               @default(0)
  isDeposit         Boolean           @default(false)
  paymentMethodId   String?
  paymentLabel      String?
  transactionRef    String?
  paymentProofKey   String?
  paymentStatus     PaymentStatus     @default(UNPAID)
  status            OrderStatus       @default(PENDING)
  note              String?
  /// Result of the last automatic payment check or a duplicate-reference warning (shown to staff)
  paymentCheck      String?
  /// When the customer was asked (on Telegram) to review this order
  reviewAskedAt     DateTime?
  /// Driver delivering this order (Batch D)
  driverId          String?
  driver            Driver?           @relation(fields: [driverId], references: [id])
  /// Ordered while the product was on pre-order (arrives later)
  isPreorder        Boolean           @default(false)
  /// 4-digit code the customer gives the driver to confirm delivery (only the customer sees it)
  deliveryCode      String?
  deliveryCodeTries Int               @default(0)
  /// Discounts (all computed on the server): total and breakdown [{ kind, label, amount, code? }]
  discountTotal     Int               @default(0)
  discounts         Json?
  /// Free gift promised by a promotion ("Free perfume sample") — staff add it to the parcel
  giftNote          String?
  promotionId       String?
  creditUsed        Int               @default(0)
  /// Customer who invited the buyer (referral reward goes to them once this order is received)
  referrerId        String?
  promotion         Promotion?        @relation(fields: [promotionId], references: [id])
  exchanges         ExchangeRequest[]
  supportRequests   SupportRequest[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user   User?        @relation(fields: [userId], references: [id])
  items  OrderItem[]
  events OrderEvent[]
  cards  AdminCard[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  variantId   String
  productId   String
  productName String
  size        String  @default("")
  color       String  @default("")
  imageKey    String?
  unitPrice   Int
  costPrice   Int     @default(0)
  quantity    Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String
  message   String?
  actorId   String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])

  @@index([orderId, createdAt])
}

enum StockReason {
  ORDER
  CANCEL
  RESTOCK
  ADJUST
}

model StockMovement {
  id        String      @id @default(cuid())
  variantId String
  delta     Int
  reason    StockReason
  orderId   String?
  actorId   String?
  createdAt DateTime    @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  actor   User?          @relation(fields: [actorId], references: [id])

  @@index([variantId, createdAt])
}

// ─── Store configuration ─────────────────────────────────

model PaymentMethod {
  id            String  @id // telebirr, cbe, mpesa, ...
  name          String
  kind          String // "wallet" | "bank"
  accountName   String  @default("")
  accountNumber String  @default("")
  isEnabled     Boolean @default(false)
  sortOrder     Int     @default(0)
}

model DeliveryOption {
  id           String  @id // addis, regional, pickup
  nameEn       String
  nameAm       String
  noteEn       String  @default("")
  noteAm       String  @default("")
  // null = fee is confirmed by phone
  fee          Int?
  needsAddress Boolean @default(true)
  isEnabled    Boolean @default(true)
  sortOrder    Int     @default(0)
}

/// Website "sign in through the bot" requests. Stored in the database (not memory) so they survive
/// server restarts/sleep and work with more than one server. `id` is the SHA-256 of the token sent to
/// the browser, so a database leak can't be used to complete someone's sign-in.
model LoginToken {
  id          String    @id
  telegramId  BigInt?
  identity    Json?
  confirmedAt DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
}

/// Channel auto-import queue. Telegram delivers each photo of an album as a separate update, so a post
/// is collected here first (in the database, so restarts lose nothing) and turned into a draft product
/// once it has been quiet for a few seconds. Also records the shop's OWN posts so they're never imported.
model ChannelImport {
  /// "<chatId>:g<mediaGroupId>" for albums, "<chatId>:m<messageId>" for single posts
  id         String   @id
  chatId     String
  messageIds Int[]
  fileIds    String[]
  caption    String   @default("")
  postedAt   DateTime
  /// collecting | processing | done | skipped | own | failed
  status     String   @default("collecting")
  attempts   Int      @default(0)
  productId  String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, updatedAt])
}

/// One-time codes the owner sends to the bot ("/link CODE") to connect a chat or channel.
/// Stored in the database so they survive server restarts (Render restarts on every deploy).
model LinkCode {
  code      String   @id
  purpose   String // "admin" | "channel"
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Settings {
  id                     String   @id @default("default")
  storeName              String   @default("Hikma Men's Fashion")
  phone                  String   @default("0955706969")
  telegramInbox          String   @default("Hikm5506")
  telegramChannelUrl     String   @default("")
  tikTokHandle           String   @default("hikutiiiiiiii")
  addressEn              String   @default("Betel, Yellow Building, opposite MK Building · Shop G2")
  addressAm              String   @default("ቤተል ቢጫ ፎቅ፣ ፊትለፊት MK ህንፃ፣ ሱቅ ቁጥር G2")
  mapLat                 Float?
  mapLng                 Float?
  openingHours           String   @default("Mon–Sun · 8:30 – 21:00")
  announcementEn         String   @default("")
  announcementAm         String   @default("")
  heroVideoUrl           String?
  heroImageUrl           String?
  partialPaymentEnabled  Boolean  @default(true)
  depositPercent         Int      @default(50)
  returnPolicyEn         String   @default("")
  returnPolicyAm         String   @default("")
  // Telegram
  /// New posts in the linked channel become draft products
  channelAutoImport      Boolean  @default(true)
  /// Automatic payment checking (ShegerPay). Off by default: payments are confirmed manually.
  autoVerifyPayments     Boolean  @default(false)
  /// Provider API key set by the owner (falls back to SHEGERPAY_API_KEY). Never sent to the browser.
  paymentVerifyKey       String?
  channelChatId          String?
  adminChatId            String?
  /// Evening summary sent to the order-alerts chat
  dailyReport            Boolean  @default(true)
  /// Hour (Addis Ababa time, 0–23) the daily report is sent
  reportHour             Int      @default(21)
  /// Addis date ("YYYY-MM-DD") of the last report sent, so it's sent once even across restarts
  lastReportDate         String?
  /// One Telegram reminder to signed-in customers who leave items in their bag
  bagReminders           Boolean  @default(true)
  // Rewards — off until the owner turns them on (they cost money)
  /// Customers earn shop credit on received orders (percent of what they paid)
  loyaltyEnabled         Boolean  @default(false)
  loyaltyPercent         Int      @default(2)
  /// Invite a friend: friend gets ETB off the first order, inviter gets ETB credit once it is received
  referralEnabled        Boolean  @default(false)
  referralReward         Int      @default(500)
  referralFriendDiscount Int      @default(500)
  referralMinSubtotal    Int      @default(3000)
  /// Credit can pay at most this share of an order
  creditMaxPercent       Int      @default(50)
  /// Customers can ask for a size exchange this many days after receiving an order
  exchangeDays           Int      @default(3)
  updatedAt              DateTime @updatedAt
}

/// The bag of a signed-in customer, kept on the server so a reminder can be sent if it's left behind.
model CartSnapshot {
  userId     String    @id
  /// [{ variantId, quantity }]
  items      Json
  itemCount  Int       @default(0)
  updatedAt  DateTime  @updatedAt
  remindedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

// ─── Discounts & rewards ─────────────────────────────────

enum PromoType {
  PERCENT
  FIXED
  GIFT
}

/// A campaign (automatic, no code) or a promo code. One promotion per order: the best one applies.
model Promotion {
  id             String    @id @default(cuid())
  name           String
  /// null = automatic campaign (applies to everyone while it runs)
  code           String?   @unique
  type           PromoType
  /// percent (PERCENT) or ETB (FIXED)
  value          Int       @default(0)
  /// GIFT: what the customer gets ("Free perfume sample")
  giftText       String?
  minSubtotal    Int       @default(0)
  /// limit to one category (slug), null = everything
  categorySlug   String?
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean   @default(true)
  maxUses        Int?
  usedCount      Int       @default(0)
  onePerCustomer Boolean   @default(true)
  /// Shown at the top of the shop while an automatic campaign runs
  bannerEn       String?
  bannerAm       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders Order[]
}

/// "Complete the look": products bought together get a discount.
model Bundle {
  id              String       @id @default(cuid())
  name            String
  nameAm          String?
  discountPercent Int
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  items           BundleItem[]
}

model BundleItem {
  bundleId  String
  productId String
  sortOrder Int    @default(0)

  bundle  Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([bundleId, productId])
  @@index([productId])
}

/// Shop credit ledger (ETB). Balance = sum of amounts. One entry per (user, order, reason) so awards are never doubled.
model CreditEntry {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  /// loyalty | referral | redeem | refund | adjust
  reason    String
  orderId   String?
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orderId, reason])
  @@index([userId, createdAt])
}

// ─── After the purchase ──────────────────────────────────

/// Saved items. priceSeen = the price when saved (or last told), so a price drop is announced once.
model WishlistItem {
  userId    String
  productId String
  priceSeen Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
}

/// "Wrong size? Request exchange" from a received order.
model ExchangeRequest {
  id        String   @id @default(cuid())
  orderId   String
  userId    String
  /// [{ orderItemId, name, size, wantSize }]
  items     Json
  /// too_small | too_big | defect | other
  reason    String
  note      String?
  /// requested | approved | declined | done
  status    String   @default("requested")
  staffNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([orderId])
}

/// "Need help with this order?" — a short conversation between the customer and staff about one order.
model SupportRequest {
  id        String   @id @default(cuid())
  orderId   String
  userId    String
  /// where | payment | wrong_item | damaged | other
  topic     String
  /// open | solved
  status    String   @default("open")
  /// [{ from: "customer" | "staff", text, at, by? }]
  messages  Json
  /// who wrote last (a customer message means it waits for staff)
  lastFrom  String   @default("customer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@index([orderId])
}

// ─── Running the shop ────────────────────────────────────

/// Delivery person. Linked to their Telegram with a one-time code (/driver CODE), then gets order cards.
model Driver {
  id              String   @id @default(cuid())
  name            String
  phone           String
  telegramId      BigInt?  @unique
  linkCode        String?  @unique
  isActive        Boolean  @default(true)
  /// The order whose delivery code this driver is typing right now (in the bot chat)
  awaitingOrderId String?
  createdAt       DateTime @default(now())

  orders Order[]
}

/// Who did what in the admin (owner only). Written automatically for every staff change.
model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String
  action    String
  summary   String
  /// order | product | promotion | settings | staff | support | exchange | counter | review | driver
  entity    String?
  entityId  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}
